<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Assets\dsh.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>DSH Desktop</AssemblyTitle>
    <Product>DSH Desktop</Product>
    <DshPublishMode Condition="'$(DshPublishMode)' == ''">Aot</DshPublishMode>
    <PublishAot Condition="'$(PublishAot)' == '' and '$(DshPublishMode)' == 'Aot'">true</PublishAot>
    <PublishAot Condition="'$(PublishAot)' == '' and '$(DshPublishMode)' == 'DotNet'">false</PublishAot>
    <SelfContained Condition="'$(SelfContained)' == '' and '$(RuntimeIdentifier)' != '' and '$(DshPublishMode)' == 'Aot'">true</SelfContained>
    <SelfContained Condition="'$(SelfContained)' == '' and '$(RuntimeIdentifier)' != '' and '$(DshPublishMode)' == 'DotNet'">false</SelfContained>
    <PublishSingleFile Condition="'$(PublishSingleFile)' == '' and '$(RuntimeIdentifier)' != ''">true</PublishSingleFile>
    <PublishTrimmed Condition="'$(PublishTrimmed)' == '' and '$(DshPublishMode)' == 'Aot'">true</PublishTrimmed>
    <PublishTrimmed Condition="'$(PublishTrimmed)' == '' and '$(DshPublishMode)' == 'DotNet'">false</PublishTrimmed>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\dsh.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <AvaloniaResource Include="Assets\dsh.ico" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="LocalTests\**\*.cs" />
    <Compile Remove="DshDesktop.SetupHost\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.0.1" />
  </ItemGroup>

</Project>
