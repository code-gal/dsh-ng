<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DshNgDesktop.Views.SetupWindow"
        Title="Install DSH Desktop"
        Width="680"
        Height="510"
        MinWidth="580"
        MinHeight="440"
        WindowStartupLocation="CenterScreen"
        CanResize="False">
  <Grid Margin="36" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="16">
    <StackPanel Spacing="4">
      <TextBlock Text="DSH Desktop" FontSize="28" FontWeight="SemiBold" />
      <TextBlock Text="Installing the desktop client and its private DeepSeek Harness runtime." Opacity="0.72" TextWrapping="Wrap" />
    </StackPanel>

    <StackPanel Grid.Row="1" Spacing="5">
      <TextBlock x:Name="StageText" FontSize="18" FontWeight="SemiBold" Text="Preparing installation" />
      <TextBlock x:Name="DetailText" Opacity="0.78" TextWrapping="Wrap" />
      <ProgressBar x:Name="StageProgress" IsIndeterminate="True" Height="6" Margin="0,8,0,0" />
    </StackPanel>

    <TextBlock x:Name="RemediationText" Grid.Row="2" IsVisible="False" TextWrapping="Wrap" Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" />

    <Border Grid.Row="3" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" BorderThickness="1" CornerRadius="4" Padding="10">
      <ListBox x:Name="LogSummary" BorderThickness="0" Background="Transparent" IsHitTestVisible="False" />
    </Border>

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
      <Button x:Name="CopyDiagnosticsButton" Click="CopyDiagnosticsButton_OnClick">Copy diagnostics</Button>
      <Button x:Name="OpenLogsButton" Click="OpenLogsButton_OnClick">Open log folder</Button>
      <Button x:Name="StopButton" Click="StopButton_OnClick">Stop installation</Button>
      <Button x:Name="CloseButton" IsVisible="False" Click="CloseButton_OnClick">Close</Button>
    </StackPanel>
  </Grid>
</Window>
