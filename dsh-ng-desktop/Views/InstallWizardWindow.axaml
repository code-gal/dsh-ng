<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:views="clr-namespace:DshNgDesktop.Views"
        x:Class="DshNgDesktop.Views.InstallWizardWindow"
	x:DataType="views:InstallWizardWindow"
        Title="DSH 安装向导"
	Width="720" Height="540"
	MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterScreen">
	<Grid Margin="24" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
		<TextBlock Grid.Row="0" Text="欢迎使用 DSH Desktop" FontSize="20" FontWeight="Bold" />
		<TextBlock Grid.Row="1" Margin="0,4,0,12" Text="已检测到可用的 Node.js / npm 环境。" />
		<TextBlock Grid.Row="2" Name="StatusText" Margin="0,0,0,4" Text="尚未安装 DSH。" />
		<TextBlock Grid.Row="3" Name="ErrorText" Margin="0,0,0,8" Foreground="Red" TextWrapping="Wrap" />
		<Border Grid.Row="4" BorderBrush="Gray" BorderThickness="1" CornerRadius="4">
			<TextBox Name="LogOutput" IsReadOnly="True" AcceptsReturn="True"
					 FontSize="12" TextWrapping="Wrap"
					 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
					 ScrollViewer.VerticalScrollBarVisibility="Auto" />
		</Border>
		<StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
			<Button Name="CancelButton" Margin="0,0,8,0" Content="停止并清理" Click="OnCancelButtonClick" IsVisible="False" />
			<Button Name="InstallButton" Content="安装 DSH" Click="OnInstallButtonClick" />
		</StackPanel>
	</Grid>
</Window>
