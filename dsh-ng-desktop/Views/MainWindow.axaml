<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DshNgDesktop.Views.MainWindow"
        Title="DSH Desktop"
        Width="900"
        Height="600"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterScreen">
  <StackPanel Margin="40"
              Spacing="12"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
    <TextBlock Text="DSH Desktop"
               FontSize="28"
               FontWeight="SemiBold"
               HorizontalAlignment="Center" />
    <TextBlock Text="DSH Desktop 已完成安装。运行窗口、WebView 与托盘体验将在后续里程碑中启用。"
               Opacity="0.7"
               TextAlignment="Center" />
  </StackPanel>
</Window>
